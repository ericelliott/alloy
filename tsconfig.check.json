{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@paralleldrive/alloy-tokens": ["./packages/tokens/src/index.ts"],
      "@paralleldrive/alloy-tokens/css": ["./packages/tokens/src/css/index.ts"],
      "@paralleldrive/alloy-components": ["./packages/components/src/index.ts"]
    }
  },
  "include": ["packages/tokens/src/**/*", "packages/components/src/**/*"],
  "exclude": ["node_modules", "packages/storybook", "**/dist/**"]
}
