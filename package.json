{
  "name": "alloy",
  "private": true,
  "version": "0.0.0",
  "description": "Alloy Design System — a luxury neomorphic design system",
  "workspaces": ["packages/*"],
  "scripts": {
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit --project tsconfig.check.json",
    "test": "npm run test:unit && npm run lint && npm run typecheck",
    "test:unit": "vitest run",
    "dev": "bun run --filter storybook dev",
    "build": "bun run --filter '*' build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "jsdom": "^29.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
